{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recollection execution task",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "parent",
    "stage",
    "module_id",
    "title",
    "spec",
    "depends_on",
    "requirements",
    "acceptance_test_ids",
    "allowed_paths",
    "excluded_paths",
    "contract_changes",
    "base_commit",
    "worktree",
    "scope",
    "non_goals",
    "acceptance",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "EXECUTION"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excluded_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contract_changes": {
      "enum": [
        "forbidden",
        "approved_adr"
      ]
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "TESTING",
        "REVIEW",
        "INTEGRATING",
        "DONE",
        "BLOCKED"
      ]
    }
  }
}
